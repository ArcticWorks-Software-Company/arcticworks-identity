# ---- Database (local development) ----
DATABASE_URL=postgres://identity:identity@localhost:5433/identity

# ---- Valkey / Redis (ephemeral state: rate limiting) ----
REDIS_URL=redis://localhost:6380

# ---- HTTP ----
# Base URL of the API as seen by the outside world (used for OIDC issuer,
# links in emails and CORS).
PUBLIC_BASE_URL=http://localhost:8080
WEB_ORIGIN=http://localhost:5173
MOCK_ORIGIN=http://localhost:5174
API_BIND=0.0.0.0:8080

# ---- Sessions / tokens ----
SESSION_COOKIE_NAME=aw_session
SESSION_MAX_AGE_DAYS=30
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
REAUTH_WINDOW_MINUTES=10

# ---- Passkeys / WebAuthn ----
# Relying party ID must be a registrable domain (no port). "localhost" in dev.
RP_ID=localhost
RP_ORIGINS=http://localhost:5173

# ---- TOTP two-factor authentication ----
# Base64-encoded 32-byte key encrypting TOTP secrets at rest. Generate with
# `openssl rand -base64 32`. Unset = ephemeral key (secrets lost on restart).
# Development-only example value:
TOTP_ENC_KEY=ieaRmDPIvwoIhS6PsUpoOfFOxD7LnOLyjDvKYyXZHQo=

# ---- Email ----
# Development: use the mailpit container (SMTP on 1025). Set SMTP_* for real
# delivery; email sending falls back to console logging if SMTP_HOST is empty.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ArcticWorks Identity <identity@arcticworks.dev>
# TLS mode: starttls | tls | none
SMTP_TLS=starttls

# ---- Rate limiting ----
# Registration attempts per IP per hour (security default: 3; raise in dev).
REGISTER_RATE_LIMIT_PER_HOUR=3

# ---- Seed (development only) ----
SEED_ADMIN_EMAIL=admin@arcticworks.dev
SEED_ADMIN_PASSWORD=ChangeMe-1234
SEED_ORG_NAME=ArcticWorks
